<!DOCTYPE html>
<html>
<head>
    <title>SC Finance Assist</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<%- include("partials/navbar") %>

<section class="hero">

    <div class="hero-text">

        <span class="badge">FINANCIAL ASSISTANCE PLATFORM</span>

        <h1>
            Find the Right Financial Assistance.
            <span>Reach the Right Channel Partner.</span>
        </h1>

        <p>
            Discover suitable financial assistance options,
            understand estimated loan costs and find the
            appropriate Channel Partner.
        </p>

        <div>
            <a class="btn" href="/scheme/recommend">
                Find My Scheme →
            </a>

            <a class="btn secondary" href="#how">
                How It Works
            </a>
        </div>

    </div>

    <div class="journey">

        <h3>Your Financial Journey</h3>

        <div>✓ Check Eligibility</div>
        <div>✓ Find Suitable Scheme</div>
        <div>✓ Calculate Financing</div>
        <div>✓ Find Channel Partner</div>
        <div>○ Apply & Track</div>

    </div>

</section>

<section class="section">

    <h2>Everything You Need in One Place</h2>

    <div class="cards">

        <div class="card">
            <h3>🔍 Smart Scheme Discovery</h3>
            <p>Find suitable schemes based on your requirements.</p>
            <a href="/scheme/recommend">Check Schemes →</a>
        </div>

        <div class="card">
            <h3>🧮 Financial Calculator</h3>
            <p>Estimate EMI, interest and repayment.</p>
            <a href="/calculator">Calculate EMI →</a>
        </div>

        <div class="card">
            <h3>📍 Channel Partner Locator</h3>
            <p>Explore suitable nearby Channel Partners.</p>
            <a href="/partners">Find Partner →</a>
        </div>

    </div>

</section>

<section id="how" class="section light">

    <h2>How It Works</h2>

    <div class="steps">

        <div>
            <b>01</b>
            <h3>Tell Us About You</h3>
            <p>Enter basic income, purpose and requirement details.</p>
        </div>

        <div>
            <b>02</b>
            <h3>Find a Scheme</h3>
            <p>Our rule-based system identifies suitable options.</p>
        </div>

        <div>
            <b>03</b>
            <h3>Understand Financing</h3>
            <p>Estimate EMI and repayment.</p>
        </div>

        <div>
            <b>04</b>
            <h3>Connect</h3>
            <p>Find an appropriate Channel Partner.</p>
        </div>

    </div>

</section>

<section class="cta">

    <h2>Not sure which scheme is right for you?</h2>

    <p>Answer a few questions and let SC Finance Assist guide you.</p>

    <a class="btn" href="/scheme/recommend">
        Find My Scheme →
    </a>

</section>

<%- include("partials/footer") %>

</body>
</html>
